#!/usr/bin/env bash
# dotfiles-snapshot: dump machine state that is not a plain config file
# (packages, enabled services, selected /etc files...) into
# ~/.config/dotfiles-state so it can be tracked by the bare dotfiles repo.
#
# Usage:
#   dotfiles-snapshot            regenerate the snapshot and show what changed
#   dotfiles-snapshot --commit   also commit the snapshot
#   dotfiles-snapshot --push     commit and push to the current branch
#
# The repo is public: only an explicit allowlist of /etc files is copied.
# Restore hints are written to $OUT/README.md.

set -u
export LC_ALL=C

OUT="${DOTFILES_STATE_DIR:-$HOME/.config/dotfiles-state}"
dotfiles() { /usr/bin/git --git-dir="$HOME/.dotfiles/" --work-tree="$HOME" "$@"; }
have() { command -v "$1" >/dev/null 2>&1; }

COMMIT=0 PUSH=0
for arg in "$@"; do
  case "$arg" in
    --commit) COMMIT=1 ;;
    --push) COMMIT=1 PUSH=1 ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

# Start clean so removed packages/files disappear from the snapshot too.
rm -rf "$OUT"
mkdir -p "$OUT"/{packages,systemd,system,etc}

# write <relative file> <command...>: keep the file only if it has content.
write() {
  local file="$OUT/$1"; shift
  "$@" >"$file" 2>/dev/null
  [[ -s "$file" ]] || rm -f "$file"
}

# ---------------------------------------------------------------- packages
if have pacman; then
  write packages/pacman-native.txt pacman -Qqen   # explicit, from repos
  write packages/pacman-aur.txt    pacman -Qqem   # explicit, foreign (AUR)
  write packages/pacman-all-versions.txt pacman -Q
fi
if have flatpak; then
  write packages/flatpak.txt flatpak list --app --columns=application,origin
  write packages/flatpak-overrides.txt sh -c 'cat ~/.local/share/flatpak/overrides/* 2>/dev/null'
fi
have pipx && write packages/pipx.txt pipx list --short
have cargo && write packages/cargo.txt sh -c "cargo install --list | grep -v '^ '"
have rustup && write packages/rustup-toolchains.txt rustup toolchain list
if have npm; then
  write packages/npm-global.txt sh -c \
    "npm ls -g --depth=0 --parseable 2>/dev/null | tail -n +2 | xargs -rn1 basename | grep -vx -e npm -e corepack"
fi
[[ -d "${GOBIN:-$HOME/go/bin}" ]] && write packages/go-bin.txt ls "${GOBIN:-$HOME/go/bin}"
for editor in code code-oss codium kiro; do
  have "$editor" && write "packages/$editor-extensions.txt" "$editor" --list-extensions
done

# ----------------------------------------------------------------- systemd
write systemd/system-enabled.txt \
  systemctl list-unit-files --state=enabled --no-legend --no-pager
write systemd/user-enabled.txt \
  systemctl --user list-unit-files --state=enabled --no-legend --no-pager
write systemd/timers.txt sh -c \
  "systemctl list-timers --all --no-legend --no-pager | awk '{print \$(NF-1)}' | sort"

# ------------------------------------------------------------------ system
write system/kernel-cmdline.txt cat /proc/cmdline
write system/kernel.txt uname -r
write system/groups.txt sh -c "id -nG | tr ' ' '\n' | sort"
write system/shell.txt sh -c 'getent passwd "$USER" | cut -d: -f7'
write system/user-themes.txt sh -c \
  'ls -1d ~/.icons/* ~/.local/share/icons/* ~/.themes/* ~/.local/share/themes/* ~/.local/share/fonts/* 2>/dev/null | sed "s#^$HOME#~#"'
have dconf && write system/dconf-interface.ini dconf dump /org/gnome/desktop/interface/
# Names only: every /etc file that differs from its package default.
have pacman && write system/etc-modified.txt sh -c \
  "pacman -Qii | sed -n -e 's/^MODIFIED[[:space:]]*//p' -e 's/[[:space:]]*\[modified\]\$//p' | sed -e 's/^Backup Files[[:space:]]*://' -e 's/^[[:space:]]*//' | sort -u"

# --------------------------------------------------------------------- etc
# Allowlist only. Never add anything holding secrets (shadow, sudoers,
# NetworkManager connections, wireguard, ssh host keys...).
ETC_ALLOW=(
  /etc/pacman.conf
  /etc/makepkg.conf
  /etc/mkinitcpio.conf
  /etc/locale.conf
  /etc/vconsole.conf
  /etc/environment
  /etc/greetd/config.toml
  /etc/sdboot-manage.conf
  /etc/security/limits.conf
  /etc/udev/rules.d
  /etc/sysctl.d
  /etc/modprobe.d
  /etc/modules-load.d
  /etc/pacman.d/hooks
  /etc/X11/xorg.conf.d
)
for path in "${ETC_ALLOW[@]}"; do
  [[ -r "$path" ]] || continue
  if [[ -d "$path" ]]; then
    [[ -n "$(ls -A "$path" 2>/dev/null)" ]] || continue
    mkdir -p "$OUT$path"
    cp -rL --no-preserve=mode,ownership "$path/." "$OUT$path/" 2>/dev/null
  else
    mkdir -p "$OUT$(dirname "$path")"
    cp -L --no-preserve=mode,ownership "$path" "$OUT$path" 2>/dev/null
  fi
done

# ------------------------------------------------------------------ readme
cat >"$OUT/README.md" <<'EOF'
# dotfiles-state

Generated by `dotfiles-snapshot`. Do not edit by hand; rerun the script.

## Restore on a fresh install

```bash
cd ~/.config/dotfiles-state
sudo pacman -S --needed - < packages/pacman-native.txt
yay -S --needed - < packages/pacman-aur.txt
awk '{print $1}' packages/flatpak.txt | xargs -r flatpak install -y flathub
awk '{print $1}' packages/pipx.txt | xargs -rn1 pipx install
awk '{print $1}' packages/cargo.txt | xargs -r cargo install
xargs -r npm install -g < packages/npm-global.txt
xargs -rn1 code --install-extension < packages/code-extensions.txt
awk '{print $1}' systemd/system-enabled.txt | xargs -r sudo systemctl enable
awk '{print $1}' systemd/user-enabled.txt | xargs -r systemctl --user enable
```

- `etc/` mirrors selected files from `/etc`; review and copy back with sudo.
- `system/etc-modified.txt` lists every `/etc` file changed from its package
  default (names only), as a checklist of what else was tweaked.
- `system/groups.txt`: `sudo usermod -aG <group> $USER` for each one missing.
- `system/kernel-cmdline.txt`: reference for the boot entry options.
EOF

# ------------------------------------------------------------------ report
dotfiles add -A -- "$OUT"
echo "Snapshot written to ${OUT/#$HOME/\~}"
if dotfiles diff --cached --quiet -- "$OUT"; then
  echo "No changes since last snapshot."
  exit 0
fi
dotfiles diff --cached --stat -- "$OUT"

if (( COMMIT )); then
  dotfiles commit -q -m "Update system state snapshot ($(hostname), $(date +%F))" -- "$OUT"
  echo "Committed."
  (( PUSH )) && dotfiles push
else
  echo "Staged, not committed. Run with --commit or --push."
fi
