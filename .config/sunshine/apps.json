{
    "apps": [
        {
            "image-path": "desktop.png",
            "name": "Desktop"
        },
        {
            "auto-detach": true,
            "cmd": "",
            "elevated": false,
            "exclude-global-prep-cmd": false,
            "exit-timeout": 5,
            "image-path": "",
            "name": "Dual Monitor",
            "output": "",
            "prep-cmd": [
                {
                    "do": "hyprctl output create headless && hyprctl eval 'hl.monitor({ output = \"HEADLESS-1\", mode = \"1920x1080@144\", position = \"0x385\", scale = 1 })'",
                    "undo": "hyprctl output remove HEADLESS-1"
                }
            ],
            "wait-all": true
        },
        {
            "image-path": "desktop.png",
            "name": "Low Res Desktop",
            "prep-cmd": [
                {
                    "do": "xrandr --output HDMI-1 --mode 1920x1080",
                    "undo": "xrandr --output HDMI-1 --mode 1920x1200"
                }
            ]
        },
        {
            "detached": [
                "setsid steam steam://open/bigpicture"
            ],
            "image-path": "steam.png",
            "name": "Steam Big Picture",
            "prep-cmd": [
                {
                    "do": "",
                    "undo": "setsid steam steam://close/bigpicture"
                }
            ]
        }
    ],
    "env": {
        "PATH": "$(PATH):$(HOME)/.local/bin"
    }
}